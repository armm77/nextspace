{
    "## Comment" = "Do NOT change this file, Gorm maintains it";
    AppController = {
	Actions = (
	    "showPrefPanel:",
	    "showInspector:",
	    "openImage:",
	    "imageWindowWillClose:",
	    "setDefaultSize:",
	    "showInfoPanel:"
	);
	Outlets = (
	    infoPanel,
	    infoPanel
	);
	Super = NSObject;
    };
    FirstResponder = {
	Actions = (
	    "imageWindowWillClose:",
	    "openImage:",
	    "resetPreferences:",
	    "setCacheSize:",
	    "setDefaultSize:",
	    "setOpenRecursive:",
	    "setPreferences:",
	    "showInfoPanel:",
	    "showInspector:",
	    "showPrefPanel:"
	);
	Super = NSObject;
    };
    PrefController = {
	Actions = (
	    "resetPreferences:",
	    "setPreferences:",
	    "setCacheSize:",
	    "setOpenRecursive:"
	);
	Outlets = (
	    window,
	    cacheSizeField,
	    openRecursive,
	    window,
	    cacheSizeField,
	    openRecursive
	);
	Super = NSObject;
    };
}